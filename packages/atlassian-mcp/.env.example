# Copy to .env locally. Never commit real secrets.
ATLASSIAN_BASE_URL=https://your-site.atlassian.net
# OAuth (preferred) — register app; scopes read-first (Confluence/Jira read)
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
ATLASSIAN_OAUTH_ACCESS_TOKEN=
# Vaulted PAT only as last-resort credential material behind APIM (not laptop scripts)
ATLASSIAN_API_TOKEN=
ATLASSIAN_EMAIL=
# Force stub responses even if tokens are set
ATLASSIAN_DRY_RUN=1
